# apps/api — variáveis de ambiente (EXEMPLO). Copie para apps/api/.env.
# NUNCA commite o .env real nem coloque segredos aqui (CLAUDE.md §4).

NODE_ENV=development
PORT=3333

# Conexões (use os serviços locais do docker-compose quando existir).
DATABASE_URL=postgresql://vero:vero@localhost:5432/vero
REDIS_URL=redis://localhost:6379

# Segredo do JWT — gere um aleatório com >=32 chars (ex.: `openssl rand -hex 32`).
JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-ou-mais-caracteres

# Origens permitidas no CORS (separadas por vírgula; nunca "*").
CORS_ORIGINS=http://localhost:3000

# Integração WhatsApp (Evolution API) — segredos SÓ no backend (CLAUDE.md §7).
# Opcionais: a API sobe sem elas; o envio falha fechado até estarem configuradas.
# A URL nunca recebe input do usuário (anti-SSRF). NUNCA commite a key real.
EVOLUTION_API_URL=https://evolution.example.com
EVOLUTION_API_KEY=troque-pela-sua-api-key-da-evolution
EVOLUTION_INSTANCE=vero
# Segredo que a Evolution deve enviar no webhook (header x-webhook-token ou ?token=).
# Sem ele, o webhook recusa tudo (fail-closed). NUNCA commite o valor real.
EVOLUTION_WEBHOOK_SECRET=troque-por-um-segredo-aleatorio-do-webhook

# Push (Expo) — OPCIONAL. O Expo aceita envio sem token; quando presente eleva o
# rate-limit/segurança (Authorization Bearer). Crie em expo.dev. NUNCA commite o real.
EXPO_ACCESS_TOKEN=
