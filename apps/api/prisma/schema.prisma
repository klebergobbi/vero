// Vero — schema Prisma.
// S2: núcleo multi-tenant Org/Acesso (CLAUDE.md §6).
// Regra de ouro (§2): TODA tabela de negócio tem `tenantId`; nenhuma query roda
// sem filtro de tenant (o tenant-scoped helper da S4 força `where: { tenantId }`).
// Exceção documentada: `Permission` é catálogo de sistema (global), não dado de tenant.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Raiz multi-tenant. Cada clínica/franquia é um Tenant isolado.
model Tenant {
  id        String    @id @default(cuid())
  /// slug único global (usado em URLs/identificação); o restante é escopado por tenant.
  slug      String    @unique
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft-delete preparado

  clinics         Clinic[]
  units           Unit[]
  users           User[]
  roles           Role[]
  userUnits       UserUnit[]
  rolePermissions RolePermission[]
  auditLogs       AuditLog[]
  patients         Patient[]
  appointments     Appointment[]
  availabilities   Availability[]
  confirmationEvents ConfirmationEvent[]
  deviceTokens     DeviceToken[]
  notifications    Notification[]
  waitListEntries  WaitList[]
  procedures       Procedure[]
  plans            Plan[]
  priceTable       PriceTable[]
}

/// Pessoa jurídica/marca dentro do tenant (§6: Tenant→Clinic→Unit).
model Clinic {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  units  Unit[]

  @@index([tenantId])
}

/// Unidade física (consultório) de uma clínica.
model Unit {
  id        String    @id @default(cuid())
  tenantId  String
  clinicId  String
  name      String
  /// fuso da unidade — base para regras de agenda (§6/S6).
  timezone  String    @default("America/Sao_Paulo")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinic         Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  userUnits      UserUnit[]
  appointments   Appointment[]
  availabilities Availability[]

  @@index([tenantId])
  @@index([clinicId])
}

/// Usuário do sistema (gestor, dentista, recepção, financeiro...). Um papel por usuário.
model User {
  id           String    @id @default(cuid())
  tenantId     String
  /// email único POR TENANT (não global) — §S2 segurança.
  email        String
  /// hash argon2 da senha; a senha em claro NUNCA é persistida nem logada (§4).
  passwordHash String
  name         String
  roleId       String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role           Role           @relation(fields: [roleId], references: [id])
  units          UserUnit[]
  appointments   Appointment[]  @relation("ProfessionalAppointments")
  availabilities Availability[] @relation("ProfessionalAvailability")
  deviceTokens   DeviceToken[]
  notifications  Notification[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([roleId])
}

/// Unidades que um usuário pode acessar (§6: UserUnit). Escopado por tenant.
model UserUnit {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  unitId    String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@index([tenantId])
  @@index([unitId])
}

/// Papel (RBAC) por tenant. `key` em string permite papéis customizados sem
/// migration de enum; os de sistema (GESTOR/DENTISTA/RECEPCAO/FINANCEIRO) têm isSystem=true.
model Role {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  name      String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       User[]
  permissions RolePermission[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

/// Catálogo GLOBAL de permissões (definição de sistema, não dado de tenant).
/// Populado pelo seed a partir de @vero/types (fonte única). Sem tenantId por design.
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

/// Associação papel↔permissão (deny-by-default: ausência = sem acesso). Escopado por tenant.
model RolePermission {
  id           String   @id @default(cuid())
  tenantId     String
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([tenantId])
  @@index([permissionId])
}

/// Trilha de auditoria (§4 A09). NUNCA armazenar PII aqui — apenas ids, ação e
/// metadados não-sensíveis. `metadata` é JSON livre, mas os callers garantem ausência de PII.
model AuditLog {
  id         String      @id @default(cuid())
  tenantId   String
  action     AuditAction
  /// usuário que originou o evento (nullable: ex. falha de login sem usuário resolvido).
  actorId    String?
  /// tipo/id do recurso afetado (ex.: "Patient" / id) — sem nomes/PII.
  targetType String?
  targetId   String?
  ip         String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
}

/// Espelha AUDIT_ACTIONS em @vero/types (mantenha ambos em sincronia).
enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  AUTHZ_DENIED
  SENSITIVE_READ
  PERMISSION_CHANGED
  ACCOUNT_DELETED
}

/// Paciente (§6: Patient — origem do lead, indicado_por). Tenant-scoped, soft-delete preparado.
/// Cadastro rápido de 1ª consulta: só `name`+`phone`+`leadSource` obrigatórios.
model Patient {
  id           String     @id @default(cuid())
  tenantId     String
  name         String
  /// telefone normalizado (só dígitos): 10 (fixo) ou 11 (celular).
  phone        String
  /// CPF normalizado (só dígitos); único por tenant quando informado.
  cpf          String?
  email        String?
  birthDate    DateTime?
  leadSource   LeadSource
  /// auto-relação: paciente que indicou este (quando leadSource = INDICACAO_PACIENTE).
  referredById String?
  notes        String?
  /// hash argon2 da senha do App do Paciente (null = paciente ainda sem acesso ao app).
  passwordHash String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referredBy   Patient?      @relation("PatientReferral", fields: [referredById], references: [id])
  referrals    Patient[]     @relation("PatientReferral")
  appointments Appointment[]
  deviceTokens DeviceToken[]
  notifications Notification[]

  @@unique([tenantId, cpf])
  @@index([tenantId])
  @@index([referredById])
}

/// Espelha LEAD_SOURCES em @vero/types (mantenha ambos em sincronia).
enum LeadSource {
  INDICACAO_PACIENTE
  INDICACAO_PROFISSIONAL
  INSTAGRAM
  FACEBOOK
  GOOGLE
  WHATSAPP
  SITE
  OUTROS
}

/// Agendamento (§6: Appointment — status, marcadores). Tenant-scoped, soft-delete.
/// `startsAt`/`endsAt` são instantes UTC; o fuso da unidade rege as regras de disponibilidade.
model Appointment {
  id             String            @id @default(cuid())
  tenantId       String
  unitId         String
  /// profissional responsável (User com papel DENTISTA, em geral).
  professionalId String
  patientId      String
  /// sala (opcional) — modelo Room ainda não existe; usado para conflito de sala.
  roomId         String?
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(SCHEDULED)
  /// marcadores livres (ex.: "primeira-consulta", "retorno").
  markers        String[]          @default([])
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit         Unit                @relation(fields: [unitId], references: [id], onDelete: Cascade)
  professional User                @relation("ProfessionalAppointments", fields: [professionalId], references: [id])
  patient      Patient             @relation(fields: [patientId], references: [id])
  confirmations ConfirmationEvent[]
  waitList      WaitList?

  @@index([tenantId, professionalId, startsAt])
  @@index([tenantId, unitId, startsAt])
  @@index([tenantId, roomId, startsAt])
  @@index([patientId])
}

/// Evento de confirmação de presença (§6: ConfirmationEvent). Histórico por
/// agendamento; a confirmação em si é idempotente (não duplica ao confirmar 2x).
model ConfirmationEvent {
  id            String   @id @default(cuid())
  tenantId      String
  appointmentId String
  patientId     String
  /// origem da confirmação: PATIENT_APP (S11), WHATSAPP (S12)...
  source        String
  createdAt     DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([appointmentId])
}

/// Fila de espera (§6/S14). UMA entrada por agendamento ao fazer self check-in:
/// o paciente entra como WAITING e a recepção vê na agenda em tempo real. O
/// `@unique` em appointmentId garante a idempotência (check-in 2x não duplica).
model WaitList {
  id            String         @id @default(cuid())
  tenantId      String
  appointmentId String         @unique
  patientId     String
  unitId        String
  status        WaitListStatus @default(WAITING)
  /// instante do check-in (chegada do paciente).
  arrivedAt     DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, unitId, status])
}

enum WaitListStatus {
  WAITING
  CALLED
  DONE
}

/// Token de push de um device (§6/S13). Dono = paciente OU usuário de equipe
/// (exatamente um). `token` (ExpoPushToken) é único globalmente: 1 device = 1 linha.
/// `optedOut` respeita o opt-out de push da loja (§5). Sem segredo (chave de envio).
model DeviceToken {
  id         String         @id @default(cuid())
  tenantId   String
  patientId  String?
  userId     String?
  token      String         @unique
  platform   DevicePlatform
  optedOut   Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  lastSeenAt DateTime       @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([patientId])
  @@index([userId])
}

enum DevicePlatform {
  IOS
  ANDROID
}

/// Notificação push enviada a um destinatário (§6/S13b). Histórico + idempotência
/// do envio (o job da fila push-sender é idempotente por este id). Destinatário =
/// paciente OU usuário de equipe (exatamente um). `data` é payload p/ deep-link.
model Notification {
  id        String             @id @default(cuid())
  tenantId  String
  patientId String?
  userId    String?
  type      String
  title     String
  body      String
  data      Json?
  status    NotificationStatus @default(PENDING)
  sentAt    DateTime?
  error     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([patientId])
  @@index([userId])
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// Espelha APPOINTMENT_STATUSES em @vero/types (mantenha ambos em sincronia).
enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// Janela de disponibilidade de um profissional numa unidade, por dia da semana.
/// Horários em minutos desde 00:00 no FUSO da unidade (0=domingo .. 6=sábado).
model Availability {
  id             String   @id @default(cuid())
  tenantId       String
  unitId         String
  professionalId String
  dayOfWeek      Int
  startMinute    Int
  endMinute      Int
  createdAt      DateTime @default(now())

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit         Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  professional User   @relation("ProfessionalAvailability", fields: [professionalId], references: [id])

  @@index([tenantId, professionalId, dayOfWeek])
}

/// Catálogo: procedimento ofertado pela clínica (§6/S16). Tenant-scoped.
model Procedure {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  /// código interno/TUSS (opcional).
  code            String?
  /// duração padrão em minutos (opcional) — base p/ agenda futura.
  durationMinutes Int?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prices PriceTable[]

  @@index([tenantId])
}

/// Catálogo: convênio/plano (§6/S16). "Particular" é um Plan. Tenant-scoped.
model Plan {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prices PriceTable[]

  @@index([tenantId])
}

/// Preço de um procedimento POR convênio (§6 PriceTable). Uma linha = preço de
/// (procedimento × convênio). `priceCents` em centavos (evita float em dinheiro).
model PriceTable {
  id          String   @id @default(cuid())
  tenantId    String
  procedureId String
  planId      String
  priceCents  Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  procedure Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([tenantId, procedureId, planId])
  @@index([tenantId])
  @@index([procedureId])
  @@index([planId])
}
