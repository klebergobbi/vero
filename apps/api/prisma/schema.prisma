// Vero — schema Prisma.
// S2: núcleo multi-tenant Org/Acesso (CLAUDE.md §6).
// Regra de ouro (§2): TODA tabela de negócio tem `tenantId`; nenhuma query roda
// sem filtro de tenant (o tenant-scoped helper da S4 força `where: { tenantId }`).
// Exceção documentada: `Permission` é catálogo de sistema (global), não dado de tenant.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Raiz multi-tenant. Cada clínica/franquia é um Tenant isolado.
model Tenant {
  id        String    @id @default(cuid())
  /// slug único global (usado em URLs/identificação); o restante é escopado por tenant.
  slug      String    @unique
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft-delete preparado

  clinics         Clinic[]
  units           Unit[]
  users           User[]
  roles           Role[]
  userUnits       UserUnit[]
  rolePermissions RolePermission[]
  auditLogs       AuditLog[]
  patients         Patient[]
  appointments     Appointment[]
  availabilities   Availability[]
  confirmationEvents ConfirmationEvent[]
  deviceTokens     DeviceToken[]
  notifications    Notification[]
  waitListEntries  WaitList[]
  procedures       Procedure[]
  plans            Plan[]
  priceTable       PriceTable[]
  budgets          Budget[]
  budgetItems      BudgetItem[]
  contracts        Contract[]
  signatures       Signature[]
  charges          Charge[]
  installments     Installment[]
  payments         Payment[]
  reconciliations  Reconciliation[]
  collectionRules  CollectionRule[]
  collectionEvents CollectionEvent[]
  invoices         Invoice[]
  receipts         Receipt[]
  creditChecks     CreditCheck[]
  medicalRecords   MedicalRecord[]
  recordEntries    RecordEntry[]
  attachments      Attachment[]
  odontograms      Odontogram[]
  toothConditions  ToothCondition[]
  anamnesisTemplates AnamnesisTemplate[]
  anamneses        Anamnesis[]
  specialtyForms   SpecialtyForm[]
  treatmentPlans   TreatmentPlan[]
  treatmentItems   TreatmentItem[]
  executionLogs    ExecutionLog[]
  alignerCases     AlignerCase[]
  alignerSteps     AlignerStep[]
}

/// Pessoa jurídica/marca dentro do tenant (§6: Tenant→Clinic→Unit).
model Clinic {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  units  Unit[]

  @@index([tenantId])
}

/// Unidade física (consultório) de uma clínica.
model Unit {
  id        String    @id @default(cuid())
  tenantId  String
  clinicId  String
  name      String
  /// fuso da unidade — base para regras de agenda (§6/S6).
  timezone  String    @default("America/Sao_Paulo")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinic         Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  userUnits      UserUnit[]
  appointments   Appointment[]
  availabilities Availability[]

  @@index([tenantId])
  @@index([clinicId])
}

/// Usuário do sistema (gestor, dentista, recepção, financeiro...). Um papel por usuário.
model User {
  id           String    @id @default(cuid())
  tenantId     String
  /// email único POR TENANT (não global) — §S2 segurança.
  email        String
  /// hash argon2 da senha; a senha em claro NUNCA é persistida nem logada (§4).
  passwordHash String
  name         String
  roleId       String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role           Role           @relation(fields: [roleId], references: [id])
  units          UserUnit[]
  appointments   Appointment[]  @relation("ProfessionalAppointments")
  availabilities Availability[] @relation("ProfessionalAvailability")
  deviceTokens   DeviceToken[]
  notifications  Notification[]
  recordEntries  RecordEntry[]  @relation("RecordAuthor")
  specialtyForms SpecialtyForm[] @relation("SpecialtyAuthor")
  executions     ExecutionLog[] @relation("ExecutionPerformer")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([roleId])
}

/// Unidades que um usuário pode acessar (§6: UserUnit). Escopado por tenant.
model UserUnit {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  unitId    String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@index([tenantId])
  @@index([unitId])
}

/// Papel (RBAC) por tenant. `key` em string permite papéis customizados sem
/// migration de enum; os de sistema (GESTOR/DENTISTA/RECEPCAO/FINANCEIRO) têm isSystem=true.
model Role {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  name      String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       User[]
  permissions RolePermission[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

/// Catálogo GLOBAL de permissões (definição de sistema, não dado de tenant).
/// Populado pelo seed a partir de @vero/types (fonte única). Sem tenantId por design.
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

/// Associação papel↔permissão (deny-by-default: ausência = sem acesso). Escopado por tenant.
model RolePermission {
  id           String   @id @default(cuid())
  tenantId     String
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([tenantId])
  @@index([permissionId])
}

/// Trilha de auditoria (§4 A09). NUNCA armazenar PII aqui — apenas ids, ação e
/// metadados não-sensíveis. `metadata` é JSON livre, mas os callers garantem ausência de PII.
model AuditLog {
  id         String      @id @default(cuid())
  tenantId   String
  action     AuditAction
  /// usuário que originou o evento (nullable: ex. falha de login sem usuário resolvido).
  actorId    String?
  /// tipo/id do recurso afetado (ex.: "Patient" / id) — sem nomes/PII.
  targetType String?
  targetId   String?
  ip         String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, action])
}

/// Espelha AUDIT_ACTIONS em @vero/types (mantenha ambos em sincronia).
enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  AUTHZ_DENIED
  SENSITIVE_READ
  PERMISSION_CHANGED
  ACCOUNT_DELETED
  CREDIT_CHECK
  CREDIT_INCLUSION
}

/// Paciente (§6: Patient — origem do lead, indicado_por). Tenant-scoped, soft-delete preparado.
/// Cadastro rápido de 1ª consulta: só `name`+`phone`+`leadSource` obrigatórios.
model Patient {
  id           String     @id @default(cuid())
  tenantId     String
  name         String
  /// telefone normalizado (só dígitos): 10 (fixo) ou 11 (celular).
  phone        String
  /// CPF normalizado (só dígitos); único por tenant quando informado.
  cpf          String?
  email        String?
  birthDate    DateTime?
  leadSource   LeadSource
  /// auto-relação: paciente que indicou este (quando leadSource = INDICACAO_PACIENTE).
  referredById String?
  notes        String?
  /// hash argon2 da senha do App do Paciente (null = paciente ainda sem acesso ao app).
  passwordHash String?
  /// opt-out de mensagens automáticas (régua de cobrança, lembretes — §S22).
  messagingOptOut Boolean @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referredBy   Patient?      @relation("PatientReferral", fields: [referredById], references: [id])
  referrals    Patient[]     @relation("PatientReferral")
  appointments Appointment[]
  deviceTokens DeviceToken[]
  notifications Notification[]
  budgets      Budget[]
  contracts    Contract[]
  charges      Charge[]
  creditChecks CreditCheck[]
  medicalRecord MedicalRecord?
  anamneses    Anamnesis[]
  treatmentPlans TreatmentPlan[]
  alignerCases AlignerCase[]

  @@unique([tenantId, cpf])
  @@index([tenantId])
  @@index([referredById])
}

/// Espelha LEAD_SOURCES em @vero/types (mantenha ambos em sincronia).
enum LeadSource {
  INDICACAO_PACIENTE
  INDICACAO_PROFISSIONAL
  INSTAGRAM
  FACEBOOK
  GOOGLE
  WHATSAPP
  SITE
  OUTROS
}

/// Agendamento (§6: Appointment — status, marcadores). Tenant-scoped, soft-delete.
/// `startsAt`/`endsAt` são instantes UTC; o fuso da unidade rege as regras de disponibilidade.
model Appointment {
  id             String            @id @default(cuid())
  tenantId       String
  unitId         String
  /// profissional responsável (User com papel DENTISTA, em geral).
  professionalId String
  patientId      String
  /// sala (opcional) — modelo Room ainda não existe; usado para conflito de sala.
  roomId         String?
  startsAt       DateTime
  endsAt         DateTime
  status         AppointmentStatus @default(SCHEDULED)
  /// marcadores livres (ex.: "primeira-consulta", "retorno").
  markers        String[]          @default([])
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit         Unit                @relation(fields: [unitId], references: [id], onDelete: Cascade)
  professional User                @relation("ProfessionalAppointments", fields: [professionalId], references: [id])
  patient      Patient             @relation(fields: [patientId], references: [id])
  confirmations ConfirmationEvent[]
  waitList      WaitList?

  @@index([tenantId, professionalId, startsAt])
  @@index([tenantId, unitId, startsAt])
  @@index([tenantId, roomId, startsAt])
  @@index([patientId])
}

/// Evento de confirmação de presença (§6: ConfirmationEvent). Histórico por
/// agendamento; a confirmação em si é idempotente (não duplica ao confirmar 2x).
model ConfirmationEvent {
  id            String   @id @default(cuid())
  tenantId      String
  appointmentId String
  patientId     String
  /// origem da confirmação: PATIENT_APP (S11), WHATSAPP (S12)...
  source        String
  createdAt     DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([appointmentId])
}

/// Fila de espera (§6/S14). UMA entrada por agendamento ao fazer self check-in:
/// o paciente entra como WAITING e a recepção vê na agenda em tempo real. O
/// `@unique` em appointmentId garante a idempotência (check-in 2x não duplica).
model WaitList {
  id            String         @id @default(cuid())
  tenantId      String
  appointmentId String         @unique
  patientId     String
  unitId        String
  status        WaitListStatus @default(WAITING)
  /// instante do check-in (chegada do paciente).
  arrivedAt     DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, unitId, status])
}

enum WaitListStatus {
  WAITING
  CALLED
  DONE
}

/// Token de push de um device (§6/S13). Dono = paciente OU usuário de equipe
/// (exatamente um). `token` (ExpoPushToken) é único globalmente: 1 device = 1 linha.
/// `optedOut` respeita o opt-out de push da loja (§5). Sem segredo (chave de envio).
model DeviceToken {
  id         String         @id @default(cuid())
  tenantId   String
  patientId  String?
  userId     String?
  token      String         @unique
  platform   DevicePlatform
  optedOut   Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  lastSeenAt DateTime       @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([patientId])
  @@index([userId])
}

enum DevicePlatform {
  IOS
  ANDROID
}

/// Notificação push enviada a um destinatário (§6/S13b). Histórico + idempotência
/// do envio (o job da fila push-sender é idempotente por este id). Destinatário =
/// paciente OU usuário de equipe (exatamente um). `data` é payload p/ deep-link.
model Notification {
  id        String             @id @default(cuid())
  tenantId  String
  patientId String?
  userId    String?
  type      String
  title     String
  body      String
  data      Json?
  status    NotificationStatus @default(PENDING)
  sentAt    DateTime?
  error     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([patientId])
  @@index([userId])
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

/// Espelha APPOINTMENT_STATUSES em @vero/types (mantenha ambos em sincronia).
enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// Janela de disponibilidade de um profissional numa unidade, por dia da semana.
/// Horários em minutos desde 00:00 no FUSO da unidade (0=domingo .. 6=sábado).
model Availability {
  id             String   @id @default(cuid())
  tenantId       String
  unitId         String
  professionalId String
  dayOfWeek      Int
  startMinute    Int
  endMinute      Int
  createdAt      DateTime @default(now())

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit         Unit   @relation(fields: [unitId], references: [id], onDelete: Cascade)
  professional User   @relation("ProfessionalAvailability", fields: [professionalId], references: [id])

  @@index([tenantId, professionalId, dayOfWeek])
}

/// Catálogo: procedimento ofertado pela clínica (§6/S16). Tenant-scoped.
model Procedure {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  /// código interno/TUSS (opcional).
  code            String?
  /// duração padrão em minutos (opcional) — base p/ agenda futura.
  durationMinutes Int?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prices      PriceTable[]
  budgetItems BudgetItem[]

  @@index([tenantId])
}

/// Catálogo: convênio/plano (§6/S16). "Particular" é um Plan. Tenant-scoped.
model Plan {
  id        String    @id @default(cuid())
  tenantId  String
  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant  Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prices  PriceTable[]
  budgets Budget[]

  @@index([tenantId])
}

/// Preço de um procedimento POR convênio (§6 PriceTable). Uma linha = preço de
/// (procedimento × convênio). `priceCents` em centavos (evita float em dinheiro).
model PriceTable {
  id          String   @id @default(cuid())
  tenantId    String
  procedureId String
  planId      String
  priceCents  Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  procedure Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([tenantId, procedureId, planId])
  @@index([tenantId])
  @@index([procedureId])
  @@index([planId])
}

/// Orçamento de um paciente (§6/S17). `totalCents` é SEMPRE recalculado no
/// backend a partir dos itens (nunca vem do front). `decidedAt` marca quando saiu
/// de OPEN (base p/ relatório de conversão). Soft-delete.
model Budget {
  id         String       @id @default(cuid())
  tenantId   String
  patientId  String
  /// convênio do orçamento (opcional; base p/ preço dos itens). null = particular.
  planId     String?
  status     BudgetStatus @default(OPEN)
  totalCents Int          @default(0)
  notes      String?
  decidedAt  DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  deletedAt  DateTime?

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient  Patient      @relation(fields: [patientId], references: [id])
  plan     Plan?        @relation(fields: [planId], references: [id])
  items    BudgetItem[]
  contract Contract?
  charge   Charge?
  treatmentPlan TreatmentPlan?

  @@index([tenantId])
  @@index([patientId])
}

/// Item de orçamento. Guarda SNAPSHOT (description + unitPriceCents) do momento
/// em que foi adicionado — o orçamento não muda se o catálogo mudar depois.
model BudgetItem {
  id             String   @id @default(cuid())
  tenantId       String
  budgetId       String
  procedureId    String
  description    String
  quantity       Int      @default(1)
  unitPriceCents Int
  createdAt      DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  budget    Budget    @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  procedure Procedure @relation(fields: [procedureId], references: [id])

  @@index([tenantId])
  @@index([budgetId])
}

enum BudgetStatus {
  OPEN
  APPROVED
  REJECTED
}

/// Contrato gerado a partir de um orçamento APROVADO (§6/S18). `body` é o snapshot
/// imutável (paciente + itens + total + termos); `contentHash` (sha256 do body) é a
/// prova de integridade. Imutável após assinado. 1 contrato por orçamento.
model Contract {
  id          String         @id @default(cuid())
  tenantId    String
  budgetId    String         @unique
  patientId   String
  body        String
  contentHash String
  status      ContractStatus @default(DRAFT)
  signedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  budget     Budget      @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  patient    Patient     @relation(fields: [patientId], references: [id])
  signatures Signature[]

  @@index([tenantId])
  @@index([patientId])
}

/// Evidência de assinatura (§6 Consent/Signature; §7 trilha IP+timestamp+hash).
/// `signedHash` = hash do body no instante da assinatura — tem que bater com o
/// `contentHash` do contrato (se não bater, o documento foi adulterado).
model Signature {
  id         String   @id @default(cuid())
  tenantId   String
  contractId String
  signerType String
  signerName String
  signedHash String
  ip         String
  userAgent  String?
  /// CLICK (assinatura eletrônica simples) ou ICP (qualificada, quando integrado).
  method     String   @default("CLICK")
  signedAt   DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contractId])
}

enum ContractStatus {
  DRAFT
  SIGNED
  CANCELLED
}

/// Cobrança de uma venda (§6/S19): transforma o orçamento aprovado em parcelas.
/// 1 cobrança por orçamento. Valores SEMPRE calculados no servidor (nunca do front).
model Charge {
  id         String        @id @default(cuid())
  tenantId   String
  budgetId   String        @unique
  patientId  String
  totalCents Int
  method     PaymentMethod
  status     ChargeStatus  @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  budget       Budget        @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  patient      Patient       @relation(fields: [patientId], references: [id])
  installments Installment[]
  payments     Payment[]

  @@index([tenantId])
  @@index([patientId])
}

/// Parcela de uma cobrança. Os artefatos de pagamento (§6 PixCharge/Boleto/
/// CardTransaction) ficam consolidados aqui p/ o MVP: `pixPayload` (copia-e-cola),
/// `boletoBarcode` (linha digitável) e `asaasPaymentId` (id externo, §7 proxy).
model Installment {
  id             String            @id @default(cuid())
  tenantId       String
  chargeId       String
  number         Int
  amountCents    Int
  dueDate        DateTime
  status         InstallmentStatus @default(PENDING)
  asaasPaymentId String?
  pixPayload     String?
  boletoBarcode  String?
  paidAt         DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  charge           Charge            @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  payment          Payment?
  collectionEvents CollectionEvent[]

  @@index([tenantId])
  @@index([chargeId])
}

/// Pagamento recebido de uma parcela (§6/S20). `installmentId` é ÚNICO → 1 pagamento
/// por parcela (idempotência durável: reprocessar o webhook não dá baixa dupla).
model Payment {
  id             String   @id @default(cuid())
  tenantId       String
  installmentId  String   @unique
  chargeId       String
  amountCents    Int
  asaasPaymentId String
  paidAt         DateTime
  createdAt      DateTime @default(now())

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  installment    Installment     @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  charge         Charge          @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  reconciliation Reconciliation?
  invoice        Invoice?
  receipt        Receipt?

  @@index([tenantId])
}

/// Conciliação: registro de que o pagamento foi casado a partir de um evento do
/// Asaas. `eventKey` (event + paymentId) é único por tenant — 2ª camada de
/// idempotência (além do unique de Payment.installmentId).
model Reconciliation {
  id        String   @id @default(cuid())
  tenantId  String
  paymentId String   @unique
  eventKey  String
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventKey])
  @@index([tenantId])
}

enum PaymentMethod {
  PIX
  BOLETO
  CARD
}

enum ChargeStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

/// Régua de cobrança (§6/S22): etapas escalonadas relativas ao vencimento.
/// `steps` = JSON [{ offsetDays, template }] — offsetDays<0 antes do venc (D-3),
/// 0 no venc (D0), >0 após (D+X). Por enquanto 1 régua padrão por tenant.
model CollectionRule {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  active    Boolean  @default(true)
  steps     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Evento de cobrança disparado para uma parcela numa etapa (§6/S22). O
/// `@@unique([installmentId, stepKey])` garante IDEMPOTÊNCIA: não reenvia a mesma
/// etapa da mesma parcela.
model CollectionEvent {
  id            String   @id @default(cuid())
  tenantId      String
  installmentId String
  /// chave da etapa (offsetDays como string, ex.: "-3", "0", "5").
  stepKey       String
  channel       String   @default("WHATSAPP")
  status        String   @default("SENT")
  createdAt     DateTime @default(now())

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  installment Installment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@unique([installmentId, stepKey])
  @@index([tenantId])
}

/// Nota fiscal de serviço (§6/S23) emitida a partir de um pagamento. `paymentId`
/// é ÚNICO (1 NFS-e por pagamento). Status reflete a emissão no integrador
/// (PlugNotas/Focus/eNotas); retorno persistido (número, PDF, erro).
model Invoice {
  id          String        @id @default(cuid())
  tenantId    String
  paymentId   String        @unique
  amountCents Int
  status      InvoiceStatus @default(PENDING)
  externalId  String?
  number      String?
  pdfUrl      String?
  error       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

enum InvoiceStatus {
  PENDING
  ISSUED
  FAILED
}

/// Recibo de um pagamento (§6/S24). Registro da emissão (número); o PDF é gerado
/// sob demanda e servido por URL assinada de expiração curta (não persiste blob).
/// `paymentId` único → 1 recibo por pagamento.
model Receipt {
  id        String   @id @default(cuid())
  tenantId  String
  paymentId String   @unique
  number    String
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Consulta/inclusão de crédito (SPC/Serasa — §6/S25). `kind` separa CONSULTA
/// (score) de INCLUSÃO (inadimplente). `consent` registra a base legal no momento.
/// Toda operação é auditada (AuditLog CREDIT_CHECK/CREDIT_INCLUSION). Segredos do
/// bureau só no backend (§7); o processamento é assíncrono (fila `spc-query`).
model CreditCheck {
  id          String            @id @default(cuid())
  tenantId    String
  patientId   String
  kind        CreditCheckKind
  status      CreditCheckStatus @default(PENDING)
  consent     Boolean           @default(false)
  /// score do bureau (consulta).
  score       Int?
  /// valor da dívida em centavos (inclusão).
  amountCents Int?
  externalId  String?
  error       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId])
  @@index([patientId])
}

enum CreditCheckKind {
  QUERY
  INCLUSION
}

enum CreditCheckStatus {
  PENDING
  DONE
  FAILED
}

/// Prontuário do paciente (§6/S26): 1 por paciente. Reúne as entradas clínicas e
/// anexos. Dado de SAÚDE — conteúdo cifrado em repouso; todo acesso → SENSITIVE_READ.
model MedicalRecord {
  id        String   @id @default(cuid())
  tenantId  String
  patientId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  entries     RecordEntry[]
  attachments Attachment[]
  odontogram  Odontogram?
  anamneses   Anamnesis[]
  specialtyForms SpecialtyForm[]

  @@index([tenantId])
}

/// Entrada do prontuário (evolução clínica). `contentEnc` = conteúdo CIFRADO em
/// repouso (AES-256-GCM) — §4 dado sensível cifrado. `authorId` = profissional.
model RecordEntry {
  id         String   @id @default(cuid())
  tenantId   String
  recordId   String
  authorId   String
  contentEnc String
  createdAt  DateTime @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  record MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  author User          @relation("RecordAuthor", fields: [authorId], references: [id])

  @@index([tenantId])
  @@index([recordId])
}

/// Anexo do prontuário (imagem/exame). Bytes CIFRADOS em repouso (`dataEnc`);
/// servido por URL assinada de expiração curta. §7: produção usa DO Spaces.
model Attachment {
  id          String   @id @default(cuid())
  tenantId    String
  recordId    String
  filename    String
  contentType String
  dataEnc     Bytes
  createdAt   DateTime @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  record MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([recordId])
}

/// Odontograma (§6/S27): mapa dental vinculado ao prontuário (1 por prontuário).
model Odontogram {
  id        String   @id @default(cuid())
  tenantId  String
  recordId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  record     MedicalRecord    @relation(fields: [recordId], references: [id], onDelete: Cascade)
  conditions ToothCondition[]

  @@index([tenantId])
}

/// Condição por dente/face (§6/S27). `face` e `condition` validados contra as
/// listas de @vero/types. Única por (odontograma, dente, face) — setar substitui.
model ToothCondition {
  id           String   @id @default(cuid())
  tenantId     String
  odontogramId String
  /// número FDI do dente (ex.: 11–48).
  toothNumber  Int
  face         String
  condition    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  odontogram Odontogram @relation(fields: [odontogramId], references: [id], onDelete: Cascade)

  @@unique([odontogramId, toothNumber, face])
  @@index([tenantId])
  @@index([odontogramId])
}

/// Modelo de anamnese reutilizável (§6/S28). `questions` = Json [{id,label}].
/// `procedureKey` opcional → template por procedimento (Orto, Implanto...).
model AnamnesisTemplate {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  procedureKey String?
  questions    Json
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  anamneses Anamnesis[]

  @@index([tenantId])
}

/// Instância de anamnese enviada a um paciente (§6/S28). Preenchida e assinada
/// REMOTAMENTE por link de USO ÚNICO (`tokenHash` + `tokenExpiresAt`). Respostas
/// CIFRADAS em repouso (`answersEnc`, dado de saúde). Evidência de assinatura
/// (reusa o esign da S18): `contentHash` (SHA-256, tamper-evident) + IP + timestamp.
/// Ao assinar, vincula-se ao prontuário (`recordId`).
model Anamnesis {
  id             String          @id @default(cuid())
  tenantId       String
  patientId      String
  templateId     String
  recordId       String?
  status         AnamnesisStatus @default(PENDING)
  answersEnc     String?
  contentHash    String?
  signerIp       String?
  signedAt       DateTime?
  /// link de uso único: SHA-256 do token (o token cru só vai no link) + expiração.
  tokenHash      String          @unique
  tokenExpiresAt DateTime
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient  Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  template AnamnesisTemplate @relation(fields: [templateId], references: [id])
  record   MedicalRecord?    @relation(fields: [recordId], references: [id])

  @@index([tenantId])
  @@index([patientId])
}

enum AnamnesisStatus {
  PENDING
  SIGNED
  CANCELLED
}

/// Ficha clínica por especialidade (§6/S29). `specialty` validado contra
/// SPECIALTY_TYPES de @vero/types; `valuesEnc` = respostas {campoId:valor} CIFRADAS
/// em repouso (dado de saúde, AES-256-GCM). VERSIONADO: cada salvamento cria uma
/// nova linha (version = anterior+1); a versão corrente é a de maior `version`.
model SpecialtyForm {
  id        String   @id @default(cuid())
  tenantId  String
  recordId  String
  specialty String
  version   Int
  valuesEnc String
  authorId  String
  createdAt DateTime @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  record MedicalRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  author User          @relation("SpecialtyAuthor", fields: [authorId], references: [id])

  @@unique([recordId, specialty, version])
  @@index([tenantId])
  @@index([recordId, specialty])
}

/// Plano de tratamento (§6/S30). Gerado a partir de um orçamento APROVADO
/// (`budgetId @unique` = 1 plano por orçamento). Executável por sessão via itens.
model TreatmentPlan {
  id        String              @id @default(cuid())
  tenantId  String
  patientId String
  budgetId  String              @unique
  status    TreatmentPlanStatus @default(ACTIVE)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient         @relation(fields: [patientId], references: [id])
  budget  Budget          @relation(fields: [budgetId], references: [id])
  items   TreatmentItem[]

  @@index([tenantId])
  @@index([patientId])
}

/// Item executável do plano (§6/S30). Snapshot da descrição do item do orçamento +
/// `quantity` sessões previstas; `doneCount` = sessões já executadas (execução por
/// sessão registra um ExecutionLog e incrementa). DONE quando doneCount == quantity.
model TreatmentItem {
  id          String              @id @default(cuid())
  tenantId    String
  planId      String
  procedureId String?
  description String
  quantity    Int                 @default(1)
  doneCount   Int                 @default(0)
  status      TreatmentItemStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan       TreatmentPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  executions ExecutionLog[]

  @@index([tenantId])
  @@index([planId])
}

/// Registro de execução de uma sessão (§6/S30). Data + profissional que executou.
model ExecutionLog {
  id            String   @id @default(cuid())
  tenantId      String
  itemId        String
  performedById String
  performedAt   DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item        TreatmentItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  performedBy User          @relation("ExecutionPerformer", fields: [performedById], references: [id])

  @@index([tenantId])
  @@index([itemId])
}

enum TreatmentPlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TreatmentItemStatus {
  PENDING
  IN_PROGRESS
  DONE
}

/// Caso de alinhadores (§6/S31). Acompanhamento por etapas (cada AlignerStep = um
/// alinhador, com data prevista de troca). `currentStep` = etapa que o paciente usa
/// agora; a "próxima troca" é a `changeDate` da etapa currentStep+1.
model AlignerCase {
  id          String            @id @default(cuid())
  tenantId    String
  patientId   String
  title       String
  totalSteps  Int
  currentStep Int               @default(1)
  status      AlignerCaseStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient Patient       @relation(fields: [patientId], references: [id])
  steps   AlignerStep[]

  @@index([tenantId])
  @@index([patientId])
}

/// Etapa (alinhador) de um caso (§6/S31). `number` 1..totalSteps; `changeDate` =
/// data prevista para começar a usar este alinhador.
model AlignerStep {
  id         String   @id @default(cuid())
  tenantId   String
  caseId     String
  number     Int
  changeDate DateTime
  notes      String?
  createdAt  DateTime @default(now())

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  case   AlignerCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, number])
  @@index([tenantId])
  @@index([caseId])
}

enum AlignerCaseStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}
