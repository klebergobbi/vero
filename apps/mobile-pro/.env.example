# apps/mobile-pro — env de EXEMPLO. Não commite o .env real (§4).
# EXPO_PUBLIC_* é embutido no bundle (thin client): só valores NÃO-secretos.

# URL da API do backend (em device físico, use o IP da máquina, não localhost).
EXPO_PUBLIC_API_URL=http://localhost:3333

# DSN do Sentry: chave PÚBLICA de cliente (não é segredo). Vazio = Sentry inativo.
EXPO_PUBLIC_SENTRY_DSN=

# Usados só no build/upload de source maps do Sentry (CI/EAS), não no bundle:
# SENTRY_ORG=
# SENTRY_PROJECT=
# EAS_PROJECT_ID=
