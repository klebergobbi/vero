# Copie para terraform.tfvars (gitignored) e preencha com valores reais.
# NUNCA commitar terraform.tfvars — só este .example, sem segredo real (§4).

do_token          = "troque-pelo-seu-token-da-api-do-digitalocean"
spaces_access_id  = "troque-pela-sua-spaces-access-key-id"
spaces_secret_key = "troque-pela-sua-spaces-secret-key"

# Gerar com: openssl rand -base64 48
jwt_secret = "troque-por-um-segredo-aleatorio-de-32-ou-mais-caracteres"

# Preencher após o 1º apply (App Platform gera a URL); reaplicar pra corrigir
# o CORS_ORIGINS depois que a URL existir.
cors_origins = "https://vero-dev-troque.ondigitalocean.app"

# Opcional (S50/S51) — vazio desabilita os recursos de IA (fail-closed).
anthropic_api_key = ""

# Opcional — chaves de integração (Evolution/Asaas/NFS-e/SPC/etc., S12/S19/S23/S25).
extra_env = {
  # EVOLUTION_API_URL      = "https://sua-instancia-evolution.example.com"
  # EVOLUTION_API_KEY      = ""
  # EVOLUTION_INSTANCE     = "vero"
  # EVOLUTION_WEBHOOK_SECRET = ""
  # ASAAS_API_URL          = "https://api-sandbox.asaas.com/v3"
  # ASAAS_API_KEY          = ""
  # ASAAS_WEBHOOK_SECRET   = ""
  # NFSE_API_URL           = ""
  # NFSE_API_KEY           = ""
  # SPC_API_URL            = ""
  # SPC_API_KEY            = ""
}
