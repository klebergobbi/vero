# Copie para terraform.tfvars (gitignored) e preencha com valores reais.
# NUNCA commitar terraform.tfvars — só este .example, sem segredo real (§4).
# Use um token/conta e um par de chaves Spaces PRÓPRIOS deste ambiente —
# segredos distintos por ambiente é requisito da S53. Considere um token de
# API separado (ou pelo menos um par de chaves Spaces) exclusivo de produção.

do_token          = "troque-pelo-seu-token-da-api-do-digitalocean"
spaces_access_id  = "troque-pela-sua-spaces-access-key-id"
spaces_secret_key = "troque-pela-sua-spaces-secret-key"

jwt_secret   = "troque-por-um-segredo-aleatorio-DIFERENTE-dos-outros-ambientes-de-32-ou-mais-caracteres"
cors_origins = "https://vero-prod-troque.ondigitalocean.app"

# Preencher quando os domínios do §0 forem confirmados (INPI/registro):
# api_domain = "api.vero.com.br"
# web_domain = "app.vero.com.br"

anthropic_api_key = ""
extra_env         = {}
