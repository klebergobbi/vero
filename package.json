{
  "name": "vero",
  "version": "0.0.0",
  "private": true,
  "description": "Vero — App de gestão para clínicas odontológicas. Monorepo Turborepo + pnpm.",
  "packageManager": "pnpm@8.15.6",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.15.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.18": ">=8.5.18",
      "uuid@<11.1.1": ">=11.1.1",
      "multer@<2.2.0": ">=2.2.0",
      "sharp@<0.35.0": ">=0.35.0",
      "minimatch@3.1.5>brace-expansion": "1.1.16",
      "minimatch@9.0.9>brace-expansion": "2.1.2",
      "minimatch@10.2.5>brace-expansion": "5.0.8",
      "js-yaml": ">=4.3.0",
      "body-parser@<2.3.0": ">=2.3.0",
      "shell-quote@<=1.8.4": ">=1.9.0",
      "fast-uri@<=3.1.3": ">=3.1.4"
    }
  }
}
